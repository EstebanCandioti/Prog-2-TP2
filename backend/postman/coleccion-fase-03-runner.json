{
  "info": {
    "name": "TP2 Prog 2 - Semana 3 Runner Ordenado",
    "description": "Coleccion para ejecutar la semana 3 con Postman Runner. Crea agenda y turnos temporales para poder cancelar, atender, cargar historial y consultar notificaciones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const estadosEsperados = {",
          "  '00 - Preparar variables y health': 200,",
          "  '01 - Login paciente': 200,",
          "  '02 - Login operador': 200,",
          "  '03 - Login medico': 200,",
          "  '04 - Crear agenda para turnos': 201,",
          "  '05 - Crear turno para cancelar': 201,",
          "  '06 - Rechazado por superposicion esperado': 409,",
          "  '07 - Cancelar turno': 200,",
          "  '08 - Crear turno para atender': 201,",
          "  '09 - Mis turnos paciente': 200,",
          "  '10 - Turnos medico por fecha': 200,",
          "  '11 - Turnos sede por fecha': 200,",
          "  '12 - Atender turno': 200,",
          "  '13 - Crear historial clinico': 409,",
          "  '14 - Historial duplicado esperado': 409,",
          "  '15 - Historial como paciente': 200,",
          "  '16 - Historial como medico': 200,",
          "  '17 - Listar notificaciones paciente': 200,",
          "  '18 - Marcar notificacion como leida': 200",
          "};",
          "",
          "const esperado = estadosEsperados[pm.info.requestName];",
          "",
          "pm.test(`Status esperado: ${esperado}`, () => {",
          "  pm.response.to.have.status(esperado);",
          "});",
          "",
          "pm.test('Formato de respuesta del proyecto', () => {",
          "  const json = pm.response.json();",
          "  pm.expect(json).to.have.property('codigo', pm.response.code);",
          "  pm.expect(json).to.have.property('estado');",
          "  pm.expect(json).to.have.property('datos');",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "paciente_token",
      "value": ""
    },
    {
      "key": "operador_token",
      "value": ""
    },
    {
      "key": "medico_token",
      "value": ""
    },
    {
      "key": "id_paciente",
      "value": "2"
    },
    {
      "key": "id_medico",
      "value": "3"
    },
    {
      "key": "id_especialidad",
      "value": "1"
    },
    {
      "key": "id_sede",
      "value": "1"
    },
    {
      "key": "paciente_dni",
      "value": "90000010"
    },
    {
      "key": "paciente_password",
      "value": "Demo2026!"
    },
    {
      "key": "operador_dni",
      "value": "90000007"
    },
    {
      "key": "operador_password",
      "value": "Demo2026!"
    },
    {
      "key": "medico_dni",
      "value": "90000004"
    },
    {
      "key": "medico_password",
      "value": "Demo2026!"
    }
  ],
  "item": [
    {
      "name": "00 - Preparar variables y health",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString().slice(-7);",
              "const fecha = new Date(Date.now() + 42 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);",
              "pm.collectionVariables.set('run_suffix', suffix);",
              "pm.collectionVariables.set('run_fecha', fecha);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "01 - Login paciente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const login = pm.response.json().datos;",
              "if (login?.token) {",
              "  pm.collectionVariables.set('paciente_token', login.token);",
              "  pm.collectionVariables.set('id_paciente', login.usuario.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"{{paciente_dni}}\",\n  \"password\": \"{{paciente_password}}\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "02 - Login operador",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const login = pm.response.json().datos;",
              "if (login?.token) {",
              "  pm.collectionVariables.set('operador_token', login.token);",
              "  pm.collectionVariables.set('id_operador', login.usuario.id);",
              "  pm.collectionVariables.set('id_sede', login.usuario.id_sede);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"{{operador_dni}}\",\n  \"password\": \"{{operador_password}}\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "03 - Login medico",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const login = pm.response.json().datos;",
              "if (login?.token) {",
              "  pm.collectionVariables.set('medico_token', login.token);",
              "  pm.collectionVariables.set('id_medico', login.usuario.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"{{medico_dni}}\",\n  \"password\": \"{{medico_password}}\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "04 - Crear agenda para turnos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{operador_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hora_entrada\": \"16:00\",\n  \"hora_salida\": \"18:00\",\n  \"fecha\": \"{{run_fecha}}\",\n  \"id_medico\": {{id_medico}},\n  \"id_especialidad\": {{id_especialidad}},\n  \"id_sede\": {{id_sede}}\n}"
        },
        "url": "{{base_url}}/agendas"
      }
    },
    {
      "name": "05 - Crear turno para cancelar",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.datos?.id) pm.collectionVariables.set('turno_cancelar_id', json.datos.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_medico\": {{id_medico}},\n  \"id_especialidad\": {{id_especialidad}},\n  \"id_sede\": {{id_sede}},\n  \"fecha\": \"{{run_fecha}}\",\n  \"hora\": \"16:00\",\n  \"nota\": \"Turno para cancelar\"\n}"
        },
        "url": "{{base_url}}/turnos"
      }
    },
    {
      "name": "06 - Rechazado por superposicion esperado",
      "request": {
        "description": "Debe responder 409 porque usa el mismo medico, fecha y hora del turno confirmado anterior.",
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_medico\": {{id_medico}},\n  \"id_especialidad\": {{id_especialidad}},\n  \"id_sede\": {{id_sede}},\n  \"fecha\": \"{{run_fecha}}\",\n  \"hora\": \"16:00\",\n  \"nota\": \"Turno superpuesto\"\n}"
        },
        "url": "{{base_url}}/turnos"
      }
    },
    {
      "name": "07 - Cancelar turno",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          }
        ],
        "url": "{{base_url}}/turnos/{{turno_cancelar_id}}/cancelar"
      }
    },
    {
      "name": "08 - Crear turno para atender",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.datos?.id) pm.collectionVariables.set('turno_atender_id', json.datos.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{operador_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_paciente\": {{id_paciente}},\n  \"id_medico\": {{id_medico}},\n  \"id_especialidad\": {{id_especialidad}},\n  \"id_sede\": {{id_sede}},\n  \"fecha\": \"{{run_fecha}}\",\n  \"hora\": \"16:20\",\n  \"nota\": \"Turno para atender\"\n}"
        },
        "url": "{{base_url}}/turnos"
      }
    },
    {
      "name": "09 - Mis turnos paciente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const datos = pm.response.json().datos;",
              "pm.test('Mis turnos: formato paginado B11', () => {",
              "  pm.expect(datos).to.be.an('object');",
              "  pm.expect(datos.items).to.be.an('array');",
              "  pm.expect(datos.items.length).to.be.at.most(20);",
              "  pm.expect(Number.isSafeInteger(datos.total)).to.eql(true);",
              "  pm.expect(datos.total).to.be.at.least(datos.items.length);",
              "  pm.expect(datos.pagina).to.eql(1);",
              "  pm.expect(datos.limite).to.eql(20);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          }
        ],
        "url": "{{base_url}}/turnos/mis-turnos"
      }
    },
    {
      "name": "10 - Turnos medico por fecha",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{medico_token}}"
          }
        ],
        "url": "{{base_url}}/turnos/medico?fecha={{run_fecha}}"
      }
    },
    {
      "name": "11 - Turnos sede por fecha",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{operador_token}}"
          }
        ],
        "url": "{{base_url}}/turnos/sede?fecha={{run_fecha}}"
      }
    },
    {
      "name": "12 - Atender turno",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{medico_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/turnos/{{turno_atender_id}}/atender",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"diagnostico\": \"Control de prueba\",\n  \"tratamiento\": \"Reposo y control\",\n  \"observaciones\": \"Generado desde Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "13 - Crear historial clinico",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{medico_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_turno\": {{turno_atender_id}},\n  \"diagnostico\": \"Diagnostico semana 3 {{run_suffix}}\",\n  \"tratamiento\": \"Reposo y control\",\n  \"observaciones\": \"Generado desde Runner\"\n}"
        },
        "url": "{{base_url}}/historial-clinico"
      },
      "description": "Esperado 409: atender ya creó el historial. POST se conserva para turnos atendidos sin historial."
    },
    {
      "name": "14 - Historial duplicado esperado",
      "request": {
        "description": "Debe responder 409 porque ya existe historial para el mismo turno.",
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{medico_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_turno\": {{turno_atender_id}},\n  \"diagnostico\": \"Diagnostico duplicado\"\n}"
        },
        "url": "{{base_url}}/historial-clinico"
      }
    },
    {
      "name": "15 - Historial como paciente",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          }
        ],
        "url": "{{base_url}}/historial-clinico/paciente/{{id_paciente}}"
      }
    },
    {
      "name": "16 - Historial como medico",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{medico_token}}"
          }
        ],
        "url": "{{base_url}}/historial-clinico/paciente/{{id_paciente}}"
      }
    },
    {
      "name": "17 - Listar notificaciones paciente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (Array.isArray(json.datos) && json.datos[0]?.id) pm.collectionVariables.set('notificacion_id', json.datos[0].id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          }
        ],
        "url": "{{base_url}}/notificaciones"
      }
    },
    {
      "name": "18 - Marcar notificacion como leida",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          }
        ],
        "url": "{{base_url}}/notificaciones/{{notificacion_id}}/leida"
      }
    }
  ]
}
