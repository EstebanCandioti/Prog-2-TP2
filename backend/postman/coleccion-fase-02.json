    {
      "name": "Coberturas - Crear admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.datos && json.datos.id) {",
              "  pm.collectionVariables.set('cobertura_id', json.datos.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
