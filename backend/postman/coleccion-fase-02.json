          "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Admin\",\n  \"dni\": \"90100001\",\n  \"email\": \"ana.admin@ejemplo.com\",\n  \"telefono\": \"3424000001\",\n  \"fecha_nacimiento\": \"1985-03-10\",\n  \"password\": \"Demo2026!\",\n  \"rol\": \"admin\",\n  \"id_cobertura\": null\n}"
