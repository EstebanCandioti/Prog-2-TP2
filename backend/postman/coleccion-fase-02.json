  "item": [
    {
      "name": "Auth - Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const login = pm.response.json().datos;",
              "if (login?.token) {",
              "  pm.collectionVariables.set('admin_token', login.token);",
              "  pm.collectionVariables.set('id_admin', login.usuario.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"{{admin_dni}}\",\n  \"password\": \"{{admin_password}}\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "Auth - Login operador",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const login = pm.response.json().datos;",
              "if (login?.token) {",
              "  pm.collectionVariables.set('operador_token', login.token);",
              "  pm.collectionVariables.set('id_operador', login.usuario.id);",
              "  pm.collectionVariables.set('id_sede', login.usuario.id_sede);",
              "}"
            ]
          }
        }
