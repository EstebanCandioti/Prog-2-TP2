{
  "info": {
    "name": "TP2 Prog 2 - Semana 2 Runner Ordenado",
    "description": "Coleccion para ejecutar la semana 2 con Postman Runner. Usa datos temporales para CRUDs y contrasenas reales de prueba.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const estadosEsperados = {",
          "  '00 - Preparar variables y health': 200,",
          "  '01 - Login admin': 200,",
          "  '02 - Login operador': 200,",
          "  '03 - Login medico': 200,",
          "  '04 - Login paciente': 200,",
          "  '05 - Coberturas disponibles publico': 200,",
          "  '06 - Crear cobertura temporal': 201,",
          "  '07 - Listar coberturas admin': 200,",
          "  '08 - Obtener cobertura temporal': 200,",
          "  '09 - Actualizar cobertura temporal': 200,",
          "  '10 - Eliminar cobertura temporal': 200,",
          "  '11 - Crear sede temporal': 201,",
          "  '12 - Listar sedes': 200,",
          "  '13 - Obtener sede temporal': 200,",
          "  '14 - Actualizar sede temporal': 200,",
          "  '15 - Eliminar sede temporal': 200,",
          "  '16 - Crear especialidad temporal': 201,",
          "  '17 - Listar especialidades': 200,",
          "  '18 - Obtener especialidad temporal': 200,",
          "  '19 - Actualizar especialidad temporal': 200,",
          "  '20 - Eliminar especialidad temporal': 200,",
          "  '21 - Registrar usuario temporal': 201,",
          "  '22 - Listar usuarios': 200,",
          "  '23 - Obtener usuario temporal': 200,",
          "  '24 - Actualizar usuario temporal': 200,",
          "  '25 - Crear agenda temporal': 201,",
          "  '26 - Listar agendas operador': 200,",
          "  '27 - Obtener agenda temporal': 200,",
          "  '28 - Actualizar agenda temporal': 200,",
          "  '29 - Eliminar agenda temporal': 200,",
          "  '30 - Paciente sin acceso a agendas esperado': 403",
          "};",
          "",
          "const esperado = estadosEsperados[pm.info.requestName];",
          "",
          "pm.test(`Status esperado: ${esperado}`, () => {",
          "  pm.response.to.have.status(esperado);",
          "});",
          "",
          "pm.test('Formato de respuesta del proyecto', () => {",
          "  const json = pm.response.json();",
          "  pm.expect(json).to.have.property('codigo', pm.response.code);",
          "  pm.expect(json).to.have.property('estado');",
          "  pm.expect(json).to.have.property('datos');",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "operador_token",
      "value": ""
    },
    {
      "key": "medico_token",
      "value": ""
    },
    {
      "key": "paciente_token",
      "value": ""
    },
    {
      "key": "id_cobertura",
      "value": "1"
    },
    {
      "key": "id_sede",
      "value": "1"
    },
    {
      "key": "id_especialidad",
      "value": "1"
    },
    {
      "key": "id_medico",
      "value": "3"
    }
  ],
  "item": [
    {
      "name": "00 - Preparar variables y health",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString().slice(-7);",
              "const fecha = new Date(Date.now() + 28 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);",
              "pm.collectionVariables.set('run_suffix', suffix);",
              "pm.collectionVariables.set('run_fecha', fecha);",
              "pm.collectionVariables.set('run_dni', `7${suffix}`);",
              "pm.collectionVariables.set('run_email', `sem2.${suffix}@example.com`);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
