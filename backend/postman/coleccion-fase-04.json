            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Prueba\",\n  \"apellido\": \"Postman\",\n  \"dni\": \"45000111\",\n  \"email\": \"prueba.postman@example.com\",\n  \"telefono\": \"3424001111\",\n  \"password\": \"Paciente1.\",\n  \"fecha_nacimiento\": \"2000-01-15\",\n  \"id_cobertura\": {{id_cobertura}}\n}"
