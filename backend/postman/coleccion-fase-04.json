    {
      "name": "Agendas",
      "item": [
        {
          "name": "Listar",
          "request": {
            "description": "Roles: medico, operador. Query opcional: id_medico, id_sede, fecha. Si el rol es medico, solo ve su propia agenda. Exito: 200.",
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{operador_token}}"
              }
            ],
            "url": "{{base_url}}/agendas?id_sede={{id_sede}}&fecha=2025-10-20"
          }
        },
        {
          "name": "Obtener por id",
          "request": {
            "description": "Roles: medico, operador. Parametro: id. El medico solo puede obtener agenda propia. Exito: 200. Errores: 400, 403, 404.",
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{medico_token}}"
              }
            ],
            "url": "{{base_url}}/agendas/{{id_agenda}}"
          }
        },
