    {
      "name": "Turnos",
      "item": [
        {
          "name": "Crear como paciente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.datos && json.datos.id) {",
                  "  pm.collectionVariables.set('turno_id', json.datos.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "description": "Roles: paciente, operador. Como paciente toma el id del token. Body: id_medico, id_especialidad, id_sede, fecha, hora, nota. Exito: 201. Errores: 400, 403, 409.",
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{paciente_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_medico\": {{id_medico}},\n  \"id_especialidad\": {{id_especialidad}},\n  \"id_sede\": {{id_sede}},\n  \"fecha\": \"2025-10-20\",\n  \"hora\": \"16:00\",\n  \"nota\": \"Consulta de prueba\"\n}"
            },
            "url": "{{base_url}}/turnos"
          }
        },
        {
          "name": "Crear como operador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.datos && json.datos.id) {",
                  "  pm.collectionVariables.set('turno_atender_id', json.datos.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "description": "Rol: operador. Body igual al paciente, pero agrega id_paciente. El operador solo puede crear turnos de su sede. Exito: 201. Errores: 400, 403, 409. Guarda el id en turno_atender_id para probar la atencion del turno.",
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{operador_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_paciente\": {{id_paciente}},\n  \"id_medico\": {{id_medico}},\n  \"id_especialidad\": {{id_especialidad}},\n  \"id_sede\": {{id_sede}},\n  \"fecha\": \"2025-10-20\",\n  \"hora\": \"16:30\",\n  \"nota\": \"Turno creado por operador\"\n}"
            },
            "url": "{{base_url}}/turnos"
          }
        },
        {
