            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": "{{base_url}}/coberturas"
      }
    },
    {
      "name": "Coberturas - Crear admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.datos && json.datos.id) {",
