{
  "info": {
    "name": "TP2 Prog 2 - Backend Semana 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "paciente_token",
      "value": ""
    },
    {
      "key": "operador_token",
      "value": ""
    },
    {
      "key": "medico_token",
      "value": ""
    },
    {
      "key": "id_paciente",
      "value": "2"
    },
    {
      "key": "id_medico",
      "value": "3"
    },
    {
      "key": "id_especialidad",
      "value": "1"
    },
    {
      "key": "id_sede",
      "value": "1"
    },
    {
      "key": "turno_id",
      "value": ""
    },
    {
      "key": "turno_atender_id",
      "value": ""
    },
    {
      "key": "notificacion_id",
      "value": ""
    },
    {
      "key": "paciente_dni",
      "value": "90000010"
    },
    {
      "key": "paciente_password",
      "value": "Demo2026!"
    },
    {
      "key": "operador_dni",
      "value": "90000007"
    },
    {
      "key": "operador_password",
      "value": "Demo2026!"
    },
    {
      "key": "medico_dni",
      "value": "90000004"
    },
    {
      "key": "medico_password",
      "value": "Demo2026!"
    }
  ],
  "item": [
    {
      "name": "Auth - Login paciente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const login = pm.response.json().datos;",
              "if (login?.token) {",
              "  pm.collectionVariables.set('paciente_token', login.token);",
              "  pm.collectionVariables.set('id_paciente', login.usuario.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"{{paciente_dni}}\",\n  \"password\": \"{{paciente_password}}\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "Auth - Login operador",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const login = pm.response.json().datos;",
              "if (login?.token) {",
              "  pm.collectionVariables.set('operador_token', login.token);",
              "  pm.collectionVariables.set('id_operador', login.usuario.id);",
              "  pm.collectionVariables.set('id_sede', login.usuario.id_sede);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"{{operador_dni}}\",\n  \"password\": \"{{operador_password}}\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "Auth - Login medico",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const login = pm.response.json().datos;",
              "if (login?.token) {",
              "  pm.collectionVariables.set('medico_token', login.token);",
              "  pm.collectionVariables.set('id_medico', login.usuario.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"{{medico_dni}}\",\n  \"password\": \"{{medico_password}}\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "Turnos - Crear confirmado paciente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.datos && json.datos.id) {",
              "  pm.collectionVariables.set('turno_id', json.datos.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_medico\": {{id_medico}},\n  \"id_especialidad\": {{id_especialidad}},\n  \"id_sede\": {{id_sede}},\n  \"fecha\": \"2025-10-20\",\n  \"hora\": \"16:00\",\n  \"nota\": \"Consulta por dolor de rodilla\"\n}"
        },
        "url": "{{base_url}}/turnos"
      }
    },
    {
      "name": "Turnos - Rechazado por horario no disponible",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_medico\": {{id_medico}},\n  \"id_especialidad\": {{id_especialidad}},\n  \"id_sede\": {{id_sede}},\n  \"fecha\": \"2025-10-20\",\n  \"hora\": \"08:00\",\n  \"nota\": \"Consulta fuera de agenda\"\n}"
        },
        "url": "{{base_url}}/turnos"
      }
    },
    {
      "name": "Turnos - Rechazado por superposicion",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_medico\": {{id_medico}},\n  \"id_especialidad\": {{id_especialidad}},\n  \"id_sede\": {{id_sede}},\n  \"fecha\": \"2025-10-20\",\n  \"hora\": \"16:00\",\n  \"nota\": \"Consulta superpuesta\"\n}"
        },
        "url": "{{base_url}}/turnos"
      }
    },
    {
      "name": "Turnos - Mis turnos paciente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const datos = pm.response.json().datos;",
              "pm.test('Mis turnos: formato paginado B11', () => {",
              "  pm.expect(datos).to.be.an('object');",
              "  pm.expect(datos.items).to.be.an('array');",
              "  pm.expect(datos.items.length).to.be.at.most(20);",
              "  pm.expect(Number.isSafeInteger(datos.total)).to.eql(true);",
              "  pm.expect(datos.total).to.be.at.least(datos.items.length);",
              "  pm.expect(datos.pagina).to.eql(1);",
              "  pm.expect(datos.limite).to.eql(20);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          }
        ],
        "url": "{{base_url}}/turnos/mis-turnos"
      }
    },
    {
      "name": "Turnos - Programados medico por fecha",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{medico_token}}"
          }
        ],
        "url": "{{base_url}}/turnos/medico?fecha=2025-10-20"
      }
    },
    {
      "name": "Turnos - Sede operador por fecha",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{operador_token}}"
          }
        ],
        "url": "{{base_url}}/turnos/sede?fecha=2025-10-20"
      }
    },
    {
      "name": "Turnos - Cancelar y generar notificacion",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          }
        ],
        "url": "{{base_url}}/turnos/{{turno_id}}/cancelar"
      }
    },
    {
      "name": "Turnos - Crear para atender",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.datos && json.datos.id) {",
              "  pm.collectionVariables.set('turno_atender_id', json.datos.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_medico\": {{id_medico}},\n  \"id_especialidad\": {{id_especialidad}},\n  \"id_sede\": {{id_sede}},\n  \"fecha\": \"2025-10-20\",\n  \"hora\": \"16:20\",\n  \"nota\": \"Consulta para cargar historial\"\n}"
        },
        "url": "{{base_url}}/turnos"
      }
    },
    {
      "name": "Turnos - Atender y generar notificacion",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{medico_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/turnos/{{turno_atender_id}}/atender",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"diagnostico\": \"Control de prueba\",\n  \"tratamiento\": \"Reposo y control\",\n  \"observaciones\": \"Generado desde Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Historial - Crear sobre turno atendido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{medico_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_turno\": {{turno_atender_id}},\n  \"diagnostico\": \"Dolor de rodilla\",\n  \"tratamiento\": \"Reposo y control\",\n  \"observaciones\": \"Control en 15 dias\"\n}"
        },
        "url": "{{base_url}}/historial-clinico"
      },
      "description": "Esperado 409: atender ya creó el historial. POST se conserva para turnos atendidos sin historial."
    },
    {
      "name": "Historial - Error historial duplicado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{medico_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_turno\": {{turno_atender_id}},\n  \"diagnostico\": \"Diagnostico duplicado\"\n}"
        },
        "url": "{{base_url}}/historial-clinico"
      }
    },
    {
      "name": "Historial - Consultar paciente propio",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          }
        ],
        "url": "{{base_url}}/historial-clinico/paciente/{{id_paciente}}"
      }
    },
    {
      "name": "Historial - Consultar medico",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{medico_token}}"
          }
        ],
        "url": "{{base_url}}/historial-clinico/paciente/{{id_paciente}}"
      }
    },
    {
      "name": "Notificaciones - Listar propias",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.datos && json.datos.length > 0) {",
              "  pm.collectionVariables.set('notificacion_id', json.datos[0].id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          }
        ],
        "url": "{{base_url}}/notificaciones"
      }
    },
    {
      "name": "Notificaciones - Marcar como leida",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          }
        ],
        "url": "{{base_url}}/notificaciones/{{notificacion_id}}/leida"
      }
    }
  ]
}
