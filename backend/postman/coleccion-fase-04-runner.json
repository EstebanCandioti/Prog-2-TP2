      "name": "00 - Preparar variables y health",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString().slice(-7);",
              "const fecha = new Date(Date.now() + 35 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);",
              "pm.collectionVariables.set('run_suffix', suffix);",
              "pm.collectionVariables.set('run_fecha', fecha);",
              "pm.collectionVariables.set('run_dni', `9${suffix}`);",
              "pm.collectionVariables.set('run_email', `runner.${suffix}@example.com`);"
            ]
          }
        }
      ],
      "request": {
        "description": "Publico. Inicializa variables dinamicas para que el runner pueda repetirse.",
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
