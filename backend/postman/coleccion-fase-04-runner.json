  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const estadosEsperados = {",
          "  '00 - Preparar variables y health': 200,",
          "  '01 - Login admin': 200,",
          "  '02 - Login paciente': 200,",
          "  '03 - Login operador': 200,",
          "  '04 - Login medico': 200,",
          "  '05 - Coberturas disponibles': 200,",
          "  '06 - Perfil paciente': 200,",
          "  '07 - Crear cobertura temporal': 201,",
          "  '08 - Listar coberturas': 200,",
          "  '09 - Obtener cobertura temporal': 200,",
          "  '10 - Actualizar cobertura temporal': 200,",
          "  '11 - Eliminar cobertura temporal': 200,",
          "  '12 - Crear sede temporal': 201,",
          "  '13 - Listar sedes': 200,",
          "  '14 - Obtener sede temporal': 200,",
          "  '15 - Actualizar sede temporal': 200,",
          "  '16 - Eliminar sede temporal': 200,",
          "  '17 - Crear especialidad temporal': 201,",
          "  '18 - Listar especialidades': 200,",
          "  '19 - Obtener especialidad temporal': 200,",
          "  '20 - Actualizar especialidad temporal': 200,",
          "  '21 - Eliminar especialidad temporal': 200,",
          "  '22 - Registrar paciente temporal': 201,",
          "  '23 - Listar usuarios': 200,",
          "  '24 - Obtener usuario temporal': 200,",
          "  '25 - Actualizar usuario temporal': 200,",
          "  '26 - Crear agenda temporal para CRUD': 201,",
          "  '27 - Listar agendas': 200,",
          "  '28 - Obtener agenda temporal': 200,",
          "  '29 - Actualizar agenda temporal': 200,",
          "  '30 - Eliminar agenda temporal': 200,",
          "  '31 - Crear agenda para turnos': 201,",
          "  '32 - Crear turno para cancelar': 201,",
          "  '33 - Cancelar turno': 200,",
          "  '34 - Crear turno para atender': 201,",
          "  '35 - Mis turnos paciente': 200,",
          "  '36 - Turnos medico por fecha': 200,",
          "  '37 - Turnos sede por fecha': 200,",
          "  '38 - Atender turno': 200,",
          "  '39 - Crear historial clinico': 201,",
          "  '40 - Historial como paciente': 200,",
          "  '41 - Historial como medico': 200,",
          "  '42 - Listar notificaciones': 200,",
          "  '43 - Marcar notificacion como leida': 200,",
          "  '44 - Auditoria general': 200,",
          "  '45 - Auditoria filtrada': 200,",
          "  '46 - Reporte turnos por especialidad': 200,",
          "  '47 - Reporte turnos por sede': 200,",
          "  '48 - Reporte ranking medicos': 200,",
          "  '49 - Reporte tasa cancelacion': 200",
          "};",
          "",
          "const esperado = estadosEsperados[pm.info.requestName];",
          "",
          "pm.test(`Status esperado: ${esperado}`, () => {",
          "  pm.response.to.have.status(esperado);",
          "});",
          "",
          "pm.test('Formato de respuesta del proyecto', () => {",
          "  const json = pm.response.json();",
          "  pm.expect(json).to.have.property('codigo', pm.response.code);",
          "  pm.expect(json).to.have.property('estado');",
          "  pm.expect(json).to.have.property('datos');",
          "});"
        ]
      }
    }
  ],
