      "name": "34 - Crear turno para atender",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.datos?.id) pm.collectionVariables.set('turno_atender_id', json.datos.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{operador_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_paciente\": {{id_paciente}},\n  \"id_medico\": {{id_medico}},\n  \"id_especialidad\": {{id_especialidad}},\n  \"id_sede\": {{id_sede}},\n  \"fecha\": \"{{run_fecha}}\",\n  \"hora\": \"16:30\",\n  \"nota\": \"Turno para atender\"\n}"
        },
        "url": "{{base_url}}/turnos"
      }
    },
    {
      "name": "35 - Mis turnos paciente",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          }
        ],
        "url": "{{base_url}}/turnos/mis-turnos"
      }
    },
    {
      "name": "36 - Turnos medico por fecha",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{medico_token}}"
          }
        ],
        "url": "{{base_url}}/turnos/medico?fecha={{run_fecha}}"
      }
    },
    {
      "name": "37 - Turnos sede por fecha",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{operador_token}}"
          }
        ],
        "url": "{{base_url}}/turnos/sede?fecha={{run_fecha}}"
      }
    },
    {
      "name": "38 - Atender turno",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{medico_token}}"
          }
        ],
        "url": "{{base_url}}/turnos/{{turno_atender_id}}/atender"
      }
    },
    {
      "name": "39 - Crear historial clinico",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{medico_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_turno\": {{turno_atender_id}},\n  \"diagnostico\": \"Diagnostico runner {{run_suffix}}\",\n  \"tratamiento\": \"Tratamiento de prueba\",\n  \"observaciones\": \"Generado desde Postman Runner\"\n}"
        },
        "url": "{{base_url}}/historial-clinico"
      }
    },
    {
      "name": "40 - Historial como paciente",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          }
        ],
        "url": "{{base_url}}/historial-clinico/paciente/{{id_paciente}}"
      }
    },
    {
      "name": "41 - Historial como medico",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{medico_token}}"
          }
        ],
        "url": "{{base_url}}/historial-clinico/paciente/{{id_paciente}}"
      }
    },
    {
      "name": "42 - Listar notificaciones",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (Array.isArray(json.datos) && json.datos[0]?.id) pm.collectionVariables.set('notificacion_id', json.datos[0].id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          }
        ],
        "url": "{{base_url}}/notificaciones"
      }
    },
    {
      "name": "43 - Marcar notificacion como leida",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{paciente_token}}"
          }
        ],
        "url": "{{base_url}}/notificaciones/{{notificacion_id}}/leida"
      }
    },
    {
      "name": "44 - Auditoria general",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": "{{base_url}}/auditoria"
      }
    },
    {
      "name": "45 - Auditoria filtrada",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": "{{base_url}}/auditoria?entidad=usuario&accion=ALTA"
      }
    },
    {
      "name": "46 - Reporte turnos por especialidad",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": "{{base_url}}/reportes/turnos-por-especialidad?fecha_desde={{run_fecha}}&fecha_hasta={{run_fecha}}"
      }
    },
    {
      "name": "47 - Reporte turnos por sede",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": "{{base_url}}/reportes/turnos-por-sede?fecha_desde={{run_fecha}}&fecha_hasta={{run_fecha}}"
      }
    },
    {
      "name": "48 - Reporte ranking medicos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": "{{base_url}}/reportes/ranking-medicos?fecha_desde={{run_fecha}}&fecha_hasta={{run_fecha}}"
      }
    },
    {
      "name": "49 - Reporte tasa cancelacion",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": "{{base_url}}/reportes/tasa-cancelacion?fecha_desde={{run_fecha}}&fecha_hasta={{run_fecha}}"
      }
    }
  ]
}
